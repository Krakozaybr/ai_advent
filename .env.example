# Скопируй этот файл в .env и заполни значения один раз.
OPENROUTER_API_KEY=вставь_ключ_OpenRouter

# Одна и та же конкретная модель для дней 2–4.
OPENROUTER_MODEL=provider/model-id

# Три конкретные модели для Day 5: слабая, средняя и сильная.
DAY5_WEAK_MODEL=provider/small-model-id
DAY5_MEDIUM_MODEL=provider/medium-model-id
DAY5_STRONG_MODEL=provider/large-model-id
